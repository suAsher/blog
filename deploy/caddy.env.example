# Place on the server at /etc/caddy/blog.env, outside the project repository.
# Replace the reserved example domain with a domain you control.
BLOG_DOMAIN=knowledge.example.com
BLOG_USER=asher
# Run `caddy hash-password` interactively, then paste its complete output here.
# Keep single quotes around the hash so shell validation does not expand `$`.
BLOG_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
