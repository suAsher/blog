---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import { getArticles, formatDate, readingMinutes } from '../../lib/content';
import '../../styles/article.css';
export async function getStaticPaths() { return (await getArticles()).map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const all = await getArticles();
const next = all[(all.findIndex(a => a.id === article.id) + 1) % all.length];
---
<Layout title={article.data.title} description={article.data.description} article>
  <div class="reading-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="reading-progress-bar"></span></div>
  <div class="shell article-shell" data-reading-article={article.id}>
    <div class="article-breadcrumb"><a href="/articles/" id="back-to-articles"><Icon name="back" size={16} /> 返回文章</a><span>{article.data.category || '文章'} <i>/</i> <span>阅读空间</span></span></div>
    <script is:inline>
      // Resolve the link while parsing, before it can be clicked and without
      // waiting for the reader module. Only local collection routes are valid.
      try {
        const previous = sessionStorage.getItem('asher-return');
        const back = document.getElementById('back-to-articles');
        if (back && previous && /^\/(articles|library)\/(\?[^#]*)?$/.test(previous)) back.setAttribute('href', previous);
      } catch { /* Browsing still works when session storage is unavailable. */ }
    </script>
    <header class="article-heading"><div class="article-labels">{article.data.demo && <span class="demo-pill">示例文章 · 演示内容</span>}<span class="mono">FIELD NOTES</span></div><h1 aria-label={article.data.title}>{article.data.title.split('，').map((part, index, parts) => <span class="article-title-line">{part}{index < parts.length - 1 ? '，' : ''}</span>)}</h1><p>{article.data.description}</p><div class="article-meta"><span class="author-avatar">a</span><strong>asher</strong><span class="meta-divider"></span><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time><span><Icon name="clock" size={14} /> {readingMinutes(article.body || '')} 分钟阅读</span></div><div class="tag-row">{article.data.tags.map(tag => <a href={`/articles/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></header>
    <ArticleCover src={article.data.cover} />
    <div class="reader-layout"><aside class="toc-sidebar"><span class="eyebrow">ON THIS PAGE</span><h2>在这篇文章里</h2><nav aria-label="文章目录">{toc.map(h=><a class:list={[{ 'toc-sub': h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>)}</nav><div class="toc-progress"><span>阅读进度</span><strong id="reading-percent">0%</strong></div><p class="sidebar-note">慢慢读，让想法停留一会儿。</p></aside><div class="reader-main"><div class="reader-toolbar"><div><button class="reader-tool" data-bookmark={article.id} aria-label={`收藏：${article.data.title}`} aria-pressed="false"><Icon name="bookmark" size={17} /><span data-bookmark-label>收藏</span></button><button class="reader-tool" id="mark-read" aria-pressed="false"><Icon name="check" size={18} /><span>标为已读</span></button></div><button class="reader-tool" id="focus-toggle" aria-pressed="false"><Icon name="focus" size={17} /><span>专注阅读</span><kbd>F</kbd></button></div><details class="mobile-toc"><summary>文章目录 <span>＋</span></summary><nav aria-label="移动端文章目录">{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details><article class="prose" id="article-body"><Content /></article><div class="article-end"><span>— END OF NOTE —</span><p>读到这里，有没有一个想法值得留下？</p><span class="local-note">本机即时保存；连接私有服务后同步。状态与冲突请查看页脚。</span></div>{next && next.id !== article.id && <a class="next-article" href={`/articles/${next.id}/`}><div><span class="eyebrow">KEEP EXPLORING · 下一篇{next.data.demo ? '示例' : '文章'}</span><h2>{next.data.title}</h2></div><Icon name="arrow" size={24} /></a>}</div></div>
  </div>
  <button id="exit-focus" class="button" hidden><Icon name="focus" size={17} /> 退出专注 <kbd>Esc</kbd></button>
  <script>import '../../scripts/reader';</script>
</Layout>
